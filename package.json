{
	"name": "next-block-structure-tree",
	"version": "1.4.0",
	"description": "Adds Copy Block-Structure-Tree to the Gutenberg block context menu.",
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"lint:js": "wp-scripts lint-js",
		"plugin-zip": "node node_modules/@wordpress/scripts/scripts/plugin-zip.js",
		"build:release": "npm run build && npm run plugin-zip",
		"prepare": "husky",
		"test:e2e": "npx playwright test",
		"test:e2e:ui": "npx playwright test --ui"
	},
	"lint-staged": {
		"*.php": "composer run phpcs --"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@wordpress/env": "^10.39.0",
		"@wordpress/scripts": "^30.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0"
	}
}
