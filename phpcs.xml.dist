<?xml version="1.0"?>
<ruleset name="NExT Block Structure Tree">
    <description>Custom ruleset for NExT Block Structure Tree</description>

    <!-- Target files -->
    <file>./next-block-structure-tree.php</file>
    <file>./includes/</file>

    <!-- Exclusions -->
    <exclude-pattern>./vendor/*</exclude-pattern>
    <exclude-pattern>./node_modules/*</exclude-pattern>
    <exclude-pattern>./tests/*</exclude-pattern>
    <exclude-pattern>./build/*</exclude-pattern>

    <!-- WordPress Coding Standards -->
    <rule ref="WordPress"/>

    <!-- PHP compatibility check -->
    <rule ref="PHPCompatibilityWP"/>

    <!-- PHP version range -->
    <config name="testVersion" value="8.3-"/>

    <!-- Text domain -->
    <config name="text_domain" value="next-bst"/>

    <!-- Prefix -->
    <config name="prefixes" value="next_bst,Next_BST,NextBST"/>

    <!-- Minimum WP version -->
    <config name="minimum_wp_version" value="6.5"/>
</ruleset>
